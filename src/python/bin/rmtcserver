"""
Server wrapper for the system interface.

This is currently usused, but serves to point a way in
which we could move to a server/REST architecture
"""
import os
import getpass

from rmtc.system import Config
from rmtc import System
from rmtc.core.interface.rest.flask import Server

import argparse
parser = argparse.ArgumentParser(
    description = "Run RMTC Explorer."
)
parser.add_argument(
    "--config",
    help="Specify a config",
)
args = parser.parse_args()

if __name__ == '__main__':
    
    # Query password and user name
    username = os.environ.get("RMTC_USER")
    if username is None:
        username = input("Username: ")
    password = os.environ.get("RMTC_PW")
    if password is None:
        password = getpass.getpass("Password: ")

    rmtc_sys = System(
        config = Config(name=args.config),
        credentials = (username, password),
    )

    # attempt to open a connection
    if not rmtc_sys.is_valid():
        rmtc_sys.log.error("Invalid system - login credentials or subsystems not valid")
        exit(1)

    server = Server(rmtc_sys)
    server.run()
